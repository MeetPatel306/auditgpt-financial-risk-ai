# ── API Base URL ──────────────────────────────────────────────
# Leave empty to use Vite's proxy (recommended for local dev)
VITE_API_URL=

# ── Google OAuth 2.0 ─────────────────────────────────────────
# Only the CLIENT ID is safe to expose to the browser.
# NEVER put GOOGLE_CLIENT_SECRET here.
# Must match "Authorized JavaScript origins" in Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# The redirect URI must match "Authorized redirect URIs" in Google Cloud Console.
# For local dev: http://localhost:5173/auth/google/callback
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
